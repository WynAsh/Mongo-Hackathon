# MongoDB Atlas connection. Use "mock" for the offline in-process demo.
MONGO_URI=mock
DB_NAME=harness_architect

# Simulator and application endpoints.
SIM_MODE=fake
GATEWAY_URL=http://127.0.0.1:9000
UI_PORT=9100

# Strands through OpenRouter. Leave the key empty for the deterministic offline fallback.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_MODEL=anthropic/claude-sonnet-4.5
EMBEDDING_MODEL=openai/text-embedding-3-small

# Long-horizon campaign controls.
CAMPAIGN_ID=default
CAMPAIGN_MAX_EXPERIMENTS=20
AGENT_CONTEXT_TOKENS=12000
TRIAL_REPEATS=3
MIN_TRIAL_REQUESTS=30
POST_PROMOTION_VERIFY_S=20

# Comma-separated local Markdown/text files or HTTP(S) documentation URLs.
# The application uses curated vLLM + llm-d sources when this is omitted.
DOC_SOURCES=https://docs.vllm.ai/en/latest/configuration/engine_args/,https://docs.vllm.ai/en/latest/serving/parallelism_scaling/,https://llm-d.ai/docs/dev/architecture/core/router/epp/scheduling,https://llm-d.ai/docs/well-lit-paths/foundations/optimized-baseline,https://llm-d.ai/docs/well-lit-paths/foundations/pd-disaggregation,https://llm-d.ai/docs/well-lit-paths/foundations/workload-autoscaling
